---
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>404</title>
  </head>
  <body>
    <main class="not-found">
      <h1>404</h1>
      <p>page not found</p>
      <a href="/">home</a>
