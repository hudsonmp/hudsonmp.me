---
import Base from '../../layouts/Base.astro';
import '../../styles/essay.css';
import '../../styles/editor.css';
---
<Base title="add essay" fill>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <form id="gate" autocomplete="off">
    <input id="pw" type="password" placeholder="password" aria-label="password" autofocus />
    <span id="gate-err" role="alert"></span>
  </form>
  <script is:inline>
    // decide before first paint: a tab that already unlocked an editor never sees the password box
    try { if (sessionStorage.getItem('site-editor-key')) document.getElementById('gate').hidden = true; } catch (e) {}
  </script>

  <div id="editor" hidden>
    <div class="bar">
      <span class="tabs">
        <button type="button" id="tab-edit" class="on">edit</button>
        <button type="button" id="tab-preview">preview</button>
        <button type="button" id="tab-publish">publish</button>
      </span>
      <span class="actions">
        <button type="button" id="copy">copy .md</button>
        <button type="button" id="download">download .md</button>
      </span>
    </div>

    <div id="pane-edit" class="pane">
      <input id="title" type="text" placeholder="title" spellcheck="true" autocomplete="off" />
      <textarea id="md" spellcheck="true" autocapitalize="off" placeholder="paste markdown or rich text (Google Docs keeps headings, quotes, links, images, lists). drop or paste images. # section, ## subsection. ⌘B bold · ⌘I italic · ⌘K link · ⌘E code · ⌘⇧X strike · ⌘⌥1–3 heading · ⌘⇧V plain paste"></textarea>
    </div>

    <div id="preview" class="pane" hidden>
      <article>
        <h1 class="essay-title" id="pv-title"></h1>
        <p class="essay-date" id="pv-date" hidden></p>
        <details class="toc-inline" id="toc-inline-wrap" hidden>
          <summary>contents</summary>
          <div id="toc-inline"></div>
        </details>
        <div class="essay-body" id="pv-body"></div>
      </article>
    </div>

    <div id="pane-publish" class="pane" hidden>
      <section>
        <h3>publish this draft</h3>
        <div class="row">
          <label class="slug-row">
            <span class="prefix">hudsonmp.me/essays/</span><input id="slug" type="text" spellcheck="false" autocomplete="off" aria-label="slug" />
          </label>
          <label class="check"><input type="checkbox" id="is-private" /> private</label>
          <button type="button" id="do-publish" class="primary">publish</button>
        </div>
        <p class="status" id="publish-status" role="status"></p>
      </section>

      <section>
        <h3>essays</h3>
        <ul id="essay-admin"></ul>
        <p class="status" id="admin-status" role="status"></p>
        <p class="fine">making a published essay private doesn't remove its earlier public versions from git history.</p>
      </section>

      <section>
        <h3>passwords for private essays</h3>
        <p class="fine">any one of these opens every private essay; readers enter it once per browser. changing them re-encrypts all private essays, so readers will need a current one.</p>
        <ul id="pw-list"></ul>
        <div class="row">
          <input id="pw-new" type="text" class="field" placeholder="new password" autocomplete="off" spellcheck="false" aria-label="new password" />
          <button type="button" id="pw-add">add</button>
          <button type="button" id="pw-save" class="primary">save passwords</button>
        </div>
        <p class="status" id="pw-status" role="status"></p>
      </section>
    </div>

    <p class="hint" id="hint" role="status"></p>
  </div>

  <div slot="toc" class="toc" id="toc"></div>
</Base>

<style is:global>
  #slug {
    font: inherit;
    font-size: 0.8em;
    padding: 0.3em 0.5em;
    border: 0.5px solid #000;
    border-radius: 0;
    background: #fff;
    outline: none;
  }

  #editor { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  #editor[hidden] { display: none; }
  #editor .bar {
    flex: none;
    display: flex;
    justify-content: space-between;
    font-size: 0.75em;
    margin-bottom: 0.6em;
  }
  #editor button {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    margin-right: 1em;
    color: #888;
    cursor: pointer;
  }
  #editor button:hover,
  #editor button.on { color: #000; }
  #editor button:disabled { color: #ccc; cursor: default; }
  #editor .actions button { margin: 0 0 0 1em; }
  #editor .tabs button.on { text-decoration: underline; }

  #pane-publish { overflow-y: auto; display: block; font-size: 0.8em; padding-bottom: 1rem; }
  #pane-publish[hidden] { display: none; }
  #pane-publish section { margin-bottom: 1.6em; }
  #pane-publish h3 { font-size: 1em; margin: 0 0 0.5em; }
  #pane-publish .row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4em 1em; }
  #pane-publish .slug-row { display: inline-flex; align-items: baseline; }
  #pane-publish .prefix { color: #888; }
  #pane-publish .check { color: #444; cursor: pointer; }
  #pane-publish button { margin: 0; }
  #pane-publish button.primary { color: #000; text-decoration: underline; }
  #pane-publish .status { margin: 0.4em 0 0; color: #888; min-height: 1.2em; }
  #pane-publish .status a { color: #000; }
  #pane-publish .fine { color: #999; font-size: 0.85em; margin: 0.3em 0 0.6em; }
  #slug,
  #pane-publish .field {
    font: inherit;
    padding: 0.15em 0.35em;
    border: 0.5px solid #000;
    border-radius: 0;
    background: #fff;
    outline: none;
  }
  #slug { width: 15em; }
  #essay-admin,
  #pw-list { list-style: none; padding: 0; margin: 0; }
  #essay-admin li,
  #pw-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2em 0.9em; padding: 0.25em 0; border-bottom: 0.5px solid #eee; }
  #essay-admin .t { flex: 1; min-width: 10em; }
  #essay-admin .t a { color: #000; }
  #essay-admin .meta { color: #999; font-size: 0.85em; }
  #essay-admin .empty,
  #pw-list .empty { color: #999; border: 0; }
  #essay-admin button.danger:hover,
  #essay-admin button.confirm { color: #b00; }
  #pw-list .field { flex: 1; min-width: 8em; }

  #editor .pane { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  #editor .pane[hidden] { display: none; }
  #preview { overflow-y: auto; padding-bottom: 1rem; display: block; }
  #preview[hidden] { display: none; }

  #title,
  #md {
    font: inherit;
    width: 100%;
    box-sizing: border-box;
    border: 0.5px solid #000;
    border-radius: 0;
    background: #fff;
    outline: none;
    padding: 0.5em 0.6em;
  }
  #title { flex: none; font-size: 1em; margin-bottom: 0.5em; }
  #md {
    flex: 1;
    min-height: 0;
    resize: none;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.65em;
    line-height: 1.5;
  }
  #md.dragover { border-style: dashed; }
  #editor .hint { flex: none; margin: 0.4em 0 0; font-size: 0.6em; color: #888; min-height: 1.2em; }
</style>

<script>
  import { renderEssay, parseFrontmatter } from '../../lib/essay';
  import { tocHtml, mountToc } from '../../lib/toc';
  import { htmlToMarkdown, hasStructure } from '../../lib/html2md';
  import { saveAsset, loadAssets, assetUrl, getAsset, referencedAssets, blobToBase64, isSupportedImage } from '../../lib/assets';
  import { gate } from '../../lib/gate';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const editor = $('editor');
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} },
  };
  let key = ''; // the password, sent with publish/fetch requests so the dev server can re-check it

  // ---- editor ---------------------------------------------------------------------------------------------------
  const title = $<HTMLInputElement>('title');
  const md = $<HTMLTextAreaElement>('md');
  const hint = $('hint');

  function note(s: string, ms = 5000) {
    hint.textContent = s;
    if (ms) setTimeout(() => { if (hint.textContent === s) hint.textContent = ''; }, ms);
  }

  title.value = store.get('essay-draft-title') ?? '';
  md.value = store.get('essay-draft-md') ?? '';
  let saveTimer = 0;
  const saveDraft = () => {
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      store.set('essay-draft-title', title.value);
      store.set('essay-draft-md', md.value);
    }, 300);
  };
  title.addEventListener('input', saveDraft);
  md.addEventListener('input', saveDraft);

  // Replace [start,end) with text through execCommand so native undo/redo keeps working; fall back to setRangeText.
  function replace(start: number, end: number, text: string, selStart: number, selEnd = selStart) {
    md.focus();
    md.setSelectionRange(start, end);
    if (!document.execCommand('insertText', false, text)) {
      md.setRangeText(text, start, end, 'end');
      md.dispatchEvent(new Event('input', { bubbles: true }));
    }
    md.setSelectionRange(selStart, selEnd);
  }

  /** Insert a block (image, pasted document) with blank lines around it. */
  function insertBlock(text: string) {
    const { selectionStart: s, selectionEnd: e, value: v } = md;
    const before = v.slice(0, s);
    const after = v.slice(e);
    const lead = !before || before.endsWith('\n\n') ? '' : before.endsWith('\n') ? '\n' : '\n\n';
    const trail = !after || after.startsWith('\n\n') ? '' : after.startsWith('\n') ? '\n' : '\n\n';
    const ins = lead + text + trail;
    replace(s, e, ins, s + lead.length + text.length);
  }

  function wrap(before: string, after = before, opts: { single?: boolean } = {}) {
    const { selectionStart: s, selectionEnd: e, value: v } = md;
    const sel = v.slice(s, e);
    const outer = (n: number, side: 'l' | 'r') => (side === 'l' ? v.slice(s - n, s) : v.slice(e, e + n));
    // `*` must not be confused with the `**` of bold when toggling italic
    const notBold = !opts.single || (v[s - before.length - 1] !== before[0] && v[e + after.length] !== after[0]);
    if (s >= before.length && outer(before.length, 'l') === before && outer(after.length, 'r') === after && notBold) {
      replace(s - before.length, e + after.length, sel, s - before.length, s - before.length + sel.length);
    } else if (sel.length >= before.length + after.length && sel.startsWith(before) && sel.endsWith(after)) {
      const inner = sel.slice(before.length, sel.length - after.length);
      replace(s, e, inner, s, s + inner.length);
    } else {
      replace(s, e, before + sel + after, s + before.length, s + before.length + sel.length);
    }
  }

  function link() {
    const { selectionStart: s, selectionEnd: e, value: v } = md;
    const sel = v.slice(s, e);
    if (!sel) replace(s, e, '[]()', s + 1);
    else if (/^https?:\/\/\S+$/i.test(sel)) replace(s, e, `[](${sel})`, s + 1); // selected a URL: caret goes in the label
    else replace(s, e, `[${sel}]()`, s + sel.length + 3); // selected text: caret goes in the url
  }

  function heading(level: number) {
    const { selectionStart: s, value: v } = md;
    const ls = v.lastIndexOf('\n', s - 1) + 1;
    let le = v.indexOf('\n', s);
    if (le === -1) le = v.length;
    const line = v.slice(ls, le);
    const m = line.match(/^(#{1,6})\s+/);
    const text = m ? line.slice(m[0].length) : line;
    const next = m && m[1].length === level ? text : '#'.repeat(level) + ' ' + text;
    replace(ls, le, next, ls + next.length);
  }

  // Enter continues "- ", "* ", "1. " lists; Enter on an empty item ends the list.
  function continueList(e: KeyboardEvent) {
    const { selectionStart: s, selectionEnd: end, value: v } = md;
    if (s !== end) return;
    const ls = v.lastIndexOf('\n', s - 1) + 1;
    const m = v.slice(ls, s).match(/^(\s*)([-*+]|\d+\.)\s+(.*)$/);
    if (!m || v.slice(s).split('\n')[0].length) return; // only at end of a list line
    e.preventDefault();
    if (!m[3]) { replace(ls, s, '', ls); return; }
    const marker = /\d/.test(m[2]) ? `${parseInt(m[2], 10) + 1}.` : m[2];
    const ins = `\n${m[1]}${marker} `;
    replace(s, s, ins, s + ins.length);
  }

  let plainPaste = false;
  md.addEventListener('keydown', (e) => {
    const mod = e.metaKey || e.ctrlKey;
    plainPaste = mod && e.shiftKey && e.key.toLowerCase() === 'v';
    if (!mod) {
      if (e.key === 'Enter' && !e.shiftKey && !e.altKey) continueList(e);
      return;
    }
    const k = e.key.toLowerCase();
    if (e.altKey && /^Digit[1-6]$/.test(e.code)) { e.preventDefault(); heading(+e.code.slice(5)); }
    else if (!e.altKey && !e.shiftKey && k === 'b') { e.preventDefault(); wrap('**'); }
    else if (!e.altKey && !e.shiftKey && k === 'i') { e.preventDefault(); wrap('*', '*', { single: true }); }
    else if (!e.altKey && !e.shiftKey && k === 'k') { e.preventDefault(); link(); }
    else if (!e.altKey && !e.shiftKey && k === 'e') { e.preventDefault(); wrap('`'); }
    else if (!e.altKey && e.shiftKey && k === 'x') { e.preventDefault(); wrap('~~'); }
  });

  // ---- images: pasted/dropped files and images inside pasted documents become real files ----------------------
  async function blobFromUrl(src: string): Promise<Blob | null> {
    try {
      const r = await fetch(src, { mode: 'cors', credentials: 'omit' });
      const b = await r.blob();
      if (r.ok && isSupportedImage(b.type)) return b;
    } catch { /* CORS or network: fall through to the local server */ }
    if (src.startsWith('data:')) return null;
    try {
      const r = await fetch('/__essays/fetch', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ key, url: src }),
      });
      const b = await r.blob();
      if (r.ok && isSupportedImage(b.type)) return b;
    } catch { /* not on the dev server */ }
    return null;
  }

  const IMG = /!\[([^\]]*)\]\((<[^>]+>|[^)\s]+)([^)]*)\)/g;

  /** Replace every non-asset image source in `text` with a stored asset. */
  async function importImages(text: string): Promise<{ text: string; failed: number; imported: number }> {
    const srcs = [...new Set([...text.matchAll(IMG)].map((m) => m[2].replace(/^<|>$/g, '')))].filter((s) => !s.startsWith('asset:'));
    const map = new Map<string, string>();
    let failed = 0;
    await Promise.all(srcs.map(async (src) => {
      const blob = await blobFromUrl(src);
      if (blob) map.set(src, await saveAsset(blob));
      else failed++;
    }));
    const out = text.replace(IMG, (all, alt, raw, rest) => {
      const name = map.get(raw.replace(/^<|>$/g, ''));
      return name ? `![${alt}](asset:${name}${rest})` : all;
    });
    return { text: out, failed, imported: map.size };
  }

  async function insertImageFiles(files: File[]) {
    const imgs = files.filter((f) => f.type.startsWith('image/'));
    if (!imgs.length) return false;
    const refs: string[] = [];
    for (const f of imgs) {
      let blob: Blob = f;
      if (!isSupportedImage(f.type)) {
        // e.g. HEIC/TIFF: re-encode through a canvas so the site can serve it
        try {
          const bmp = await createImageBitmap(f);
          const c = new OffscreenCanvas(bmp.width, bmp.height);
          c.getContext('2d')!.drawImage(bmp, 0, 0);
          blob = await c.convertToBlob({ type: 'image/png' });
        } catch { note(`can't use ${f.type || 'that file'}`); continue; }
      }
      refs.push(`![](asset:${await saveAsset(blob)})`);
    }
    if (refs.length) { insertBlock(refs.join('\n\n')); note(`added ${refs.length} image${refs.length > 1 ? 's' : ''}`); }
    return true;
  }

  /** Plain text with one paragraph per line (Docs/Notes as plain text) -> markdown paragraphs. */
  function normalizePlain(text: string): string | null {
    if (!text.includes('\n') || text.includes('\n\n')) return null;
    const lines = text.split('\n');
    const isItem = (l: string) => /^\s*([-*+]|\d+[.)])\s/.test(l);
    const isRow = (l: string) => /^\s*\|/.test(l);
    let fence = false;
    let out = '';
    lines.forEach((l, i) => {
      if (i) {
        const p = lines[i - 1];
        const tight = fence || (isItem(p) && isItem(l)) || (isRow(p) && isRow(l)) || /^\s*>/.test(p) && /^\s*>/.test(l);
        out += tight ? '\n' : '\n\n';
      }
      if (/^\s*(```|~~~)/.test(l)) fence = !fence;
      out += l;
    });
    return out.trim();
  }

  md.addEventListener('paste', async (e) => {
    const dt = e.clipboardData;
    if (!dt) return;
    if (plainPaste) { plainPaste = false; return; } // ⌘⇧V: browser's plain paste, untouched

    const files = [...dt.files];
    const html = dt.getData('text/html');
    const text = dt.getData('text/plain').replace(/\r\n?/g, '\n');
    const { selectionStart: s, selectionEnd: end, value: v } = md;

    // a bare image (screenshot, copied image) with no document around it
    if (files.some((f) => f.type.startsWith('image/')) && !(html && hasStructure(html) && text.trim())) {
      e.preventDefault();
      await insertImageFiles(files);
      return;
    }
    // URL pasted over selected text -> link
    if (/^https?:\/\/\S+$/i.test(text.trim()) && s !== end) {
      e.preventDefault();
      replace(s, end, `[${v.slice(s, end)}](${text.trim()})`, s + end - s + text.trim().length + 4);
      return;
    }
    if (html && hasStructure(html)) {
      const converted = htmlToMarkdown(html);
      if (converted.trim()) {
        e.preventDefault();
        const pending = /!\[[^\]]*\]\((?!asset:)/.test(converted);
        if (pending) note('importing images…', 0);
        const { text: out, failed, imported } = pending ? await importImages(converted) : { text: converted, failed: 0, imported: 0 };
        md.setSelectionRange(s, end);
        insertBlock(out);
        saveDraft();
        note(
          'converted rich text to markdown' +
          (imported ? ` · ${imported} image${imported > 1 ? 's' : ''} saved` : '') +
          (failed ? ` · ${failed} image${failed > 1 ? 's' : ''} couldn't be downloaded (kept as links)` : ''),
        );
        return;
      }
    }
    const para = normalizePlain(text);
    if (para !== null) {
      e.preventDefault();
      replace(s, end, para, s + para.length);
      note('added paragraph breaks');
    }
  });

  md.addEventListener('dragover', (e) => {
    if ([...(e.dataTransfer?.items ?? [])].some((i) => i.kind === 'file')) { e.preventDefault(); md.classList.add('dragover'); }
  });
  md.addEventListener('dragleave', () => md.classList.remove('dragover'));
  md.addEventListener('drop', async (e) => {
    md.classList.remove('dragover');
    const files = [...(e.dataTransfer?.files ?? [])];
    if (!files.some((f) => f.type.startsWith('image/'))) return;
    e.preventDefault();
    await insertImageFiles(files);
  });

  // ---- preview --------------------------------------------------------------------------------------------------
  const tabEdit = $('tab-edit');
  const tabPreview = $('tab-preview');
  const tabPublish = $('tab-publish');
  const paneEdit = $('pane-edit');
  const preview = $('preview');
  const panePublish = $('pane-publish');
  const VIEW = 'essay-editor-view';
  const toc = $('toc');
  const tocInline = $('toc-inline');
  const tocInlineWrap = $('toc-inline-wrap');
  let unmount: Array<() => void> = [];

  const resolveImage = (src: string) => (src.startsWith('asset:') ? assetUrl(src.slice(6)) : src);

  function renderPreview() {
    const essay = renderEssay(md.value, title.value.trim(), { resolveImage });
    $('pv-title').textContent = essay.title;
    $('pv-title').hidden = !essay.title;
    $('pv-date').textContent = essay.date;
    $('pv-date').hidden = !essay.date;
    $('pv-body').innerHTML = essay.html;
    const t = tocHtml(essay.headings);
    toc.innerHTML = t;
    tocInline.innerHTML = t;
    tocInlineWrap.hidden = !t;
    unmount.forEach((u) => u());
    unmount = [mountToc(preview, toc), mountToc(preview, tocInline)];
  }

  type View = 'edit' | 'preview' | 'publish';
  function show(which: View) {
    paneEdit.hidden = which !== 'edit';
    preview.hidden = which !== 'preview';
    panePublish.hidden = which !== 'publish';
    tabEdit.classList.toggle('on', which === 'edit');
    tabPreview.classList.toggle('on', which === 'preview');
    tabPublish.classList.toggle('on', which === 'publish');
    // file writes make the dev server reload this page; come back to the same view
    try { sessionStorage.setItem(VIEW, which); } catch {}
    unmount.forEach((u) => u());
    unmount = [];
    toc.innerHTML = '';
    if (which === 'preview') { preview.scrollTop = 0; renderPreview(); }
    else if (which === 'publish') openPublish();
    else md.focus();
  }
  tabEdit.addEventListener('click', () => show('edit'));
  tabPreview.addEventListener('click', () => show('preview'));
  tabPublish.addEventListener('click', () => show('publish'));

  // ---- export ---------------------------------------------------------------------------------------------------
  const slugify = (s: string) => s.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80).replace(/-+$/, '');
  const today = () => new Date().toISOString().slice(0, 10);

  function parts() {
    const { meta, body } = parseFrontmatter(md.value);
    return { title: (meta.title || title.value).trim(), date: meta.date || today(), body: body.replace(/^\s+/, '') };
  }

  /** Self-contained .md for copy/download: assets become data URIs. */
  async function exportText() {
    const p = parts();
    let body = p.body;
    for (const name of referencedAssets(body)) {
      const a = getAsset(name);
      if (a) body = body.replaceAll(`asset:${name}`, `data:${a.type};base64,${await blobToBase64(a.blob)}`);
    }
    return { slug: slugify(p.title) || 'untitled', text: `---\ntitle: ${p.title}\ndate: ${p.date}\n---\n\n${body}` };
  }

  $('copy').addEventListener('click', async () => {
    const { text } = await exportText();
    try { await navigator.clipboard.writeText(text); note('copied'); }
    catch { note('clipboard blocked: use download .md'); }
  });
  $('download').addEventListener('click', async () => {
    const { slug, text } = await exportText();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'text/markdown' }));
    a.download = `${slug}.md`;
    a.click();
    URL.revokeObjectURL(a.href);
    note('downloaded');
  });

  // ---- publishing screen (local dev server: writes src/essays, public/essays, .private) ---------------------
  const slugInput = $<HTMLInputElement>('slug');
  const isPrivate = $<HTMLInputElement>('is-private');
  const doPublish = $<HTMLButtonElement>('do-publish');
  const status = $('publish-status');
  const adminList = $('essay-admin');
  const adminStatus = $('admin-status');
  const pwList = $('pw-list');
  const pwNew = $<HTMLInputElement>('pw-new');
  const pwStatus = $('pw-status');
  const SLUG = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
  const LOCAL_ONLY = 'publishing only works on the local dev server (npm run dev)';
  const FLASH = 'essay-editor-flash';
  type Essay = { slug: string; title: string; date: string; private: boolean };
  let exists = false;
  let checkTimer = 0;
  let passwords: string[] = [];   // saved on the server
  let pwDraft: string[] = [];     // being edited here

  async function api<T = any>(path: string, payload: object = {}): Promise<T> {
    let r: Response;
    try {
      r = await fetch(path, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ key, ...payload }) });
    } catch { throw new Error(LOCAL_ONLY); }
    if (r.status === 404 && !(r.headers.get('content-type') ?? '').includes('json')) throw new Error(LOCAL_ONLY);
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw Object.assign(new Error(j.error ?? `failed (${r.status})`), { status: r.status });
    return j;
  }

  // A write into src/ reloads this page, sometimes before the response arrives. Each action records what it
  // will report on success; after a reload the message is shown from here.
  type Flash = { target: string; text: string; slug?: string; at: number };
  const setFlash = (f: Omit<Flash, 'at'>) => { try { sessionStorage.setItem(FLASH, JSON.stringify({ ...f, at: Date.now() })); } catch {} };
  const clearFlash = () => { try { sessionStorage.removeItem(FLASH); } catch {} };
  function takeFlash(): Flash | null {
    try {
      const f = JSON.parse(sessionStorage.getItem(FLASH) ?? 'null');
      sessionStorage.removeItem(FLASH);
      return f && Date.now() - f.at < 60_000 ? f : null;
    } catch { return null; }
  }
  /** Status text; `{link}` becomes a link to the essay. */
  function say(el: HTMLElement, text: string, slug?: string) {
    if (!slug || !text.includes('{link}')) { el.textContent = text.replace('{link}', ''); return; }
    const [before, after] = text.split('{link}');
    const a = document.createElement('a');
    a.href = `/essays/${slug}`;
    a.textContent = `hudsonmp.me/essays/${slug}`;
    el.textContent = before;
    el.append(a, after ?? '');
  }

  // -- this draft
  async function checkSlug() {
    const slug = slugInput.value;
    exists = false;
    doPublish.textContent = 'publish';
    if (!SLUG.test(slug)) { status.textContent = 'lowercase letters, numbers and dashes only'; doPublish.disabled = true; return; }
    if (slug === 'add' || slug === 'index') { status.textContent = `"${slug}" is reserved`; doPublish.disabled = true; return; }
    doPublish.disabled = false;
    try {
      const r = await fetch(`/__essays/check?slug=${encodeURIComponent(slug)}`);
      if (!(r.headers.get('content-type') ?? '').includes('json')) throw 0;
      const j = await r.json();
      if (slugInput.value !== slug) return;
      exists = !!j.exists;
      if (exists) isPrivate.checked = !!j.private;
      status.textContent = exists ? `an essay already lives here (${j.private ? 'private' : 'public'}); publishing will replace it` : 'new page';
      doPublish.textContent = exists ? 'replace' : 'publish';
    } catch {
      status.textContent = LOCAL_ONLY;
      doPublish.disabled = true;
    }
  }

  slugInput.addEventListener('input', () => {
    const pos = slugInput.selectionStart;
    slugInput.value = slugInput.value.toLowerCase().replace(/[^a-z0-9-]/g, '-');
    slugInput.setSelectionRange(pos, pos);
    clearTimeout(checkTimer);
    checkTimer = window.setTimeout(checkSlug, 200);
  });
  slugInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doPublish.click(); } });
  isPrivate.addEventListener('change', () => {
    if (isPrivate.checked && !passwords.length) status.textContent = 'add and save a password below before publishing privately';
  });

  doPublish.addEventListener('click', async () => {
    const p = parts();
    const slug = slugInput.value;
    if (!p.title) { status.textContent = 'add a title first (edit tab)'; return; }
    if (!p.body.trim()) { status.textContent = 'nothing to publish yet'; return; }
    if (isPrivate.checked && !passwords.length) { status.textContent = 'add and save a password below before publishing privately'; pwNew.focus(); return; }

    // images that are still remote links: try once more to turn them into files
    let body = p.body;
    if (/!\[[^\]]*\]\((?!asset:)(?!\/)(?!data:)/.test(body)) {
      status.textContent = 'downloading images…';
      const r = await importImages(body);
      if (r.imported) { md.value = md.value.replace(p.body, () => r.text); saveDraft(); }
      body = r.text;
      if (r.failed) { status.textContent = `${r.failed} image${r.failed > 1 ? 's' : ''} couldn't be downloaded; remove or replace ${r.failed > 1 ? 'them' : 'it'} first`; return; }
    }
    const names = referencedAssets(body);
    const missing = names.filter((n) => !getAsset(n));
    if (missing.length) { status.textContent = `missing image data: ${missing.join(', ')}`; return; }

    doPublish.disabled = true;
    status.textContent = isPrivate.checked ? 'encrypting and publishing…' : 'publishing…';
    const ok = `published${isPrivate.checked ? ' (private)' : ''}: {link} · commit and deploy to put it live`;
    setFlash({ target: 'publish-status', text: ok, slug });
    try {
      const assets = await Promise.all(names.map(async (n) => {
        const a = getAsset(n)!;
        return { name: n, type: a.type, data: await blobToBase64(a.blob) };
      }));
      await api('/__essays/publish', { slug, title: p.title, date: p.date, body, assets, overwrite: exists, private: isPrivate.checked });
      say(status, ok, slug);
      exists = true;
      doPublish.textContent = 'replace';
      loadEssays();
    } catch (e) {
      clearFlash();
      const err = e as Error & { status?: number };
      if (err.status === 409) { exists = true; doPublish.textContent = 'replace'; status.textContent = 'an essay already lives here, click replace to overwrite it'; }
      else status.textContent = err.message;
    } finally {
      doPublish.disabled = false;
    }
  });

  // -- published essays
  function renderEssays(list: Essay[]) {
    if (!list.length) {
      adminList.innerHTML = '<li class="empty">nothing published yet</li>';
      return;
    }
    adminList.replaceChildren(...list.map((e) => {
      const li = document.createElement('li');
      const t = document.createElement('span');
      t.className = 't';
      const a = document.createElement('a');
      a.href = `/essays/${e.slug}`;
      a.textContent = e.title;
      const meta = document.createElement('span');
      meta.className = 'meta';
      meta.textContent = ` /${e.slug}${e.date ? ' · ' + e.date : ''}`;
      t.append(a, meta);

      const label = document.createElement('label');
      label.className = 'check';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = e.private;
      box.addEventListener('change', () => setPrivacy(e, box));
      label.append(box, ' private');

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'danger';
      del.textContent = 'delete';
      let armed = 0;
      del.addEventListener('click', () => {
        if (!armed) {
          del.textContent = 'click again to delete';
          del.classList.add('confirm');
          armed = window.setTimeout(() => { armed = 0; del.textContent = 'delete'; del.classList.remove('confirm'); }, 4000);
          return;
        }
        clearTimeout(armed);
        remove(e, del);
      });
      li.append(t, label, del);
      return li;
    }));
  }

  async function loadEssays() {
    try { renderEssays((await api<{ essays: Essay[] }>('/__essays/list')).essays); }
    catch (e) { adminList.innerHTML = ''; adminStatus.textContent = (e as Error).message; }
  }

  async function setPrivacy(e: Essay, box: HTMLInputElement) {
    const to = box.checked;
    if (to && !passwords.length) { box.checked = false; adminStatus.textContent = 'add and save a password below first'; return; }
    box.disabled = true;
    adminStatus.textContent = to ? `encrypting "${e.title}"…` : `decrypting "${e.title}"…`;
    const ok = `"${e.title}" is now ${to ? 'private' : 'public'} · commit and deploy to put it live`;
    setFlash({ target: 'admin-status', text: ok });
    try {
      renderEssays((await api<{ essays: Essay[] }>('/__essays/privacy', { slug: e.slug, private: to })).essays);
      adminStatus.textContent = ok;
    } catch (err) {
      clearFlash();
      box.checked = !to;
      box.disabled = false;
      adminStatus.textContent = (err as Error).message;
    }
  }

  async function remove(e: Essay, btn: HTMLButtonElement) {
    btn.disabled = true;
    const ok = `deleted "${e.title}" · commit and deploy to remove it from the site`;
    setFlash({ target: 'admin-status', text: ok });
    try {
      renderEssays((await api<{ essays: Essay[] }>('/__essays/delete', { slug: e.slug })).essays);
      adminStatus.textContent = ok;
      if (slugInput.value === e.slug) checkSlug();
    } catch (err) {
      clearFlash();
      btn.disabled = false;
      adminStatus.textContent = (err as Error).message;
    }
  }

  // -- reader passwords
  const pwDirty = () => pwDraft.length !== passwords.length || pwDraft.some((p, i) => p !== passwords[i]);
  function renderPasswords() {
    if (!pwDraft.length) pwList.innerHTML = '<li class="empty">no passwords yet</li>';
    else pwList.replaceChildren(...pwDraft.map((p, i) => {
      const li = document.createElement('li');
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'field';
      input.value = p;
      input.spellcheck = false;
      input.setAttribute('aria-label', `password ${i + 1}`);
      input.addEventListener('input', () => { pwDraft[i] = input.value; markPw(); });
      const rm = document.createElement('button');
      rm.type = 'button';
      rm.textContent = 'remove';
      rm.addEventListener('click', () => { pwDraft.splice(i, 1); renderPasswords(); markPw(); });
      li.append(input, rm);
      return li;
    }));
  }
  function markPw() { pwStatus.textContent = pwDirty() ? 'unsaved changes' : ''; }

  function addPassword() {
    const v = pwNew.value.trim();
    if (!v) return;
    if (pwDraft.includes(v)) { pwStatus.textContent = 'already added'; return; }
    pwDraft.push(v);
    pwNew.value = '';
    renderPasswords();
    markPw();
  }
  $('pw-add').addEventListener('click', addPassword);
  pwNew.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addPassword(); } });

  $('pw-save').addEventListener('click', async () => {
    if (pwNew.value.trim()) addPassword();
    const next = pwDraft.map((p) => p.trim()).filter(Boolean);
    const btn = $<HTMLButtonElement>('pw-save');
    btn.disabled = true;
    pwStatus.textContent = 'saving and re-encrypting private essays…';
    const ok = 'passwords saved';
    setFlash({ target: 'pw-status', text: `${ok} · private essays re-encrypted; commit and deploy to put it live` });
    try {
      const j = await api<{ passwords: string[]; resealed: number }>('/__essays/passwords', { passwords: next });
      passwords = j.passwords;
      pwDraft = [...passwords];
      renderPasswords();
      pwStatus.textContent = j.resealed ? `${ok} · re-encrypted ${j.resealed} private essay${j.resealed > 1 ? 's' : ''}; commit and deploy to put it live` : ok;
      setFlash({ target: 'pw-status', text: pwStatus.textContent }); // survives the reload the re-encryption triggers
    } catch (e) {
      clearFlash();
      pwStatus.textContent = (e as Error).message;
    } finally {
      btn.disabled = false;
    }
  });

  async function loadPasswords() {
    try {
      passwords = (await api<{ passwords: string[] }>('/__essays/passwords')).passwords;
      pwDraft = [...passwords];
      renderPasswords();
    } catch (e) { pwStatus.textContent = (e as Error).message; }
  }

  let slugChecked: Promise<void> = Promise.resolve();
  function openPublish() {
    if (!slugInput.value) slugInput.value = slugify(parts().title);
    slugChecked = checkSlug();
    loadEssays();
    loadPasswords();
  }

  async function restore() {
    let view: View = 'edit';
    try { view = (sessionStorage.getItem(VIEW) as View) || 'edit'; } catch {}
    const f = takeFlash();
    if (f?.slug) slugInput.value = f.slug;
    show(view);
    if (!f) return;
    await slugChecked; // don't let the slug check overwrite the message
    say($(f.target), f.text, f.slug);
  }

  // ---- start ----------------------------------------------------------------------------------------------------
  (async () => {
    await loadAssets();
    key = await gate();
    editor.hidden = false;
    restore();
  })();
</script>
