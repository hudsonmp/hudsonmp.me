---
import '../styles/global.css';
// MDX pages pass `frontmatter`; .astro pages pass `title`.
// `fill` makes the left column exactly the available height (used by the editor).
const { frontmatter, title: titleProp, fill = false } = Astro.props;
const title = titleProp ?? frontmatter?.title;
const hasToc = Astro.slots.has('toc');
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const here = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/">hudson c. mitchell-pullman</a>
    </header>
    <div class:list={['layout', { 'has-toc': hasToc }]}>
      <div class:list={['left', { fill }]}><slot /></div>
      <aside class="right">
        <nav class="site-nav">
          <a href="/" aria-current={here('/') ? 'page' : undefined}>home</a>
          <a href="/essays" aria-current={here('/essays') ? 'page' : undefined}>essays</a>
          <a href="/readings" aria-current={here('/readings') ? 'page' : undefined}>readings</a>
        </nav>
        <slot name="toc" />
      </aside>
    </div>
    <script>
      // footnote links scroll the nearest scroll container (a plain #hash jump can nudge the locked page)
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#fn-"], a[href^="#fnref-"]');
        const target = a && document.getElementById(a.getAttribute('href')!.slice(1));
        if (!a || !target) return;
        e.preventDefault();
        let box: HTMLElement | null = target.parentElement;
        while (box && !/(auto|scroll)/.test(getComputedStyle(box).overflowY)) box = box.parentElement;
        if (!box) return;
        const top = box.scrollTop + target.getBoundingClientRect().top - box.getBoundingClientRect().top - 24;
        box.scrollTo({ top, behavior: 'smooth' });
        history.replaceState(null, '', '#' + target.id);
      });
    </script>
    <script>
      // external links open in a new tab; internal pages (home, essays, readings, header) and mailto stay in place
      document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      });

      // clicking a mailto link also copies the address; the mailto still opens
      document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((a) => {
        a.addEventListener('click', async () => {
          const address = a.getAttribute('href')!.replace(/^mailto:/, '');
          try {
            await navigator.clipboard.writeText(address);
          } catch {
            return;
          }
          a.classList.add('copied');
          setTimeout(() => a.classList.remove('copied'), 1500);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* app-shell: the viewport never scrolls. header and sidebar stay put; only .left scrolls, and only if it overflows. */
  html, body {
    height: 100%;
    overflow: hidden;
  }
  body {
    margin: 0;
    padding: 8px 40px 0;
    box-sizing: border-box;
    height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .site-header {
    flex: none;
    text-align: center;
  }
  .site-header a {
    color: #000;
    text-decoration: none;
    font-weight: bold;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 140px;
    grid-template-areas: "text nav";
    gap: 3rem;
    grid-template-rows: minmax(0, 1fr);
    align-items: start;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    flex: 1;
    min-height: 0;
  }
  .left {
    grid-area: text;
    max-height: 100%;
    box-sizing: border-box; /* the bottom padding must not push the column past the viewport */
    overflow-y: auto;
    padding-bottom: 1rem;
  }
  /* scroll without native scrollbars */
  .layout,
  .layout * { scrollbar-width: none; }
  .layout ::-webkit-scrollbar,
  .layout::-webkit-scrollbar { display: none; }

  .left.fill {
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .left h3 { margin-bottom: 0.25em; }
  .left .more { line-height: 1.2; }

  .photo img {
    width: 280px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .right {
    grid-area: nav;
    align-self: stretch;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  /* sidebar nav only: the page you are on is blue, the rest are plain */
  .site-nav a { color: #000; }
  .site-nav a[aria-current='page'] { color: #0000ee; }
  .site-nav {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4em;
  }

  /* pages with a table of contents get a wider sidebar; the nav stays on top, the toc scrolls beneath it */
  .layout.has-toc {
    max-width: 980px;
    grid-template-columns: minmax(0, 1fr) 260px;
  }

  /* link callout: shows the destination on hover/focus; the pseudo-element sits inside the link, so it stays clickable.
     mailto links carry an obfuscated data-callout; every other link shows its href. */
  .left a {
    position: relative;
  }
  .left a::after {
    content: attr(href);
    position: absolute;
    left: 0;
    top: calc(100% + 0.4em);
    padding: 0.25em 0.7em;
    background: #fff;
    border: 0.5px solid #000;
    font-size: 0.8em;
    white-space: nowrap;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.12s ease;
    z-index: 10;
  }
  .left a[data-callout]::after {
    content: attr(data-callout);
  }
  /* invisible bridge so the pointer can travel from the link onto the callout */
  .left a::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 0.5em;
  }
  .left a:hover::after,
  .left a:focus-visible::after {
    visibility: visible;
    opacity: 1;
  }
  .left a.copied::after {
    content: "copied!";
    visibility: visible;
    opacity: 1;
  }

  /* mobile: keep the sidebar on the right, just narrower */
  @media (max-width: 700px) {
    .layout,
    .layout.has-toc {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
    }
    .toc { display: none; }
  }
</style>
