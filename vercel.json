{
  "rewrites": [
    { "source": "/__essays/:action", "destination": "/api/publish?scope=essays&action=:action" },
    { "source": "/__readings/:action", "destination": "/api/publish?scope=readings&action=:action" },
    { "source": "/__card/:action", "destination": "/api/cards?action=:action" }
  ],
  "functions": {
    "api/publish.mjs": { "maxDuration": 60 },
    "api/cards.mjs": { "includeFiles": "cards/**" }
  }
}
